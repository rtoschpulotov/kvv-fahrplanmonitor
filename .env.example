# Als .env kopieren und eigene Passwörter eintragen. Die .env kommt nicht ins Repo.
POSTGRES_USER=kvv
POSTGRES_PASSWORD=[eigenes Passwort]
POSTGRES_DB=kvv_fahrplan
MONGO_INITDB_ROOT_USERNAME=kvv
MONGO_INITDB_ROOT_PASSWORD=[eigenes Passwort]

# Für sammler/lade_landing_zone.py. Ohne Token erlaubt die GitHub-API nur 60
# Anfragen pro Stunde. Ein Fine-grained Token mit Leserecht auf dieses Repo reicht.
# Leer lassen geht auch, solange das Skript nicht zu oft hintereinander läuft.
GITHUB_TOKEN=
